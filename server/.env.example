# ==============================================================================
# AutoMask WhatsApp Automation Platform — Environment Variables Template
# ==============================================================================

NODE_ENV=development
PORT=5000

# PostgreSQL Configuration
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=automask_dev
DB_SSL=false

# Authentication & Session Security
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=automask_session

# Meta WhatsApp Cloud API Integration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verification_token
META_API_VERSION=v21.0

# Production CORS Allowed Origins (Comma-separated)
# In production, specify explicit frontend domain(s). Non-browser callers (Meta webhooks, curl) are always permitted.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://app.automask.io

# Redis / BullMQ Configuration (Required in production for webhook queues and background tasks)
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Standalone Worker Mode (Set to 'true' if running worker as dedicated process instead of inside API)
RUN_STANDALONE_WORKER=false

# OpenAI Configuration (For Semantic Vector Embeddings & RAG Knowledge Matching)
OPENAI_API_KEY=sk-placeholder-openai-api-key

# Meta WhatsApp Cloud API Outbound System Access Token
META_ACCESS_TOKEN=EAAB...placeholder_system_user_token

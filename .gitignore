# ==============================================================================
# AutoMask Security & Privacy .gitignore (Strict Production Standard)
# ==============================================================================

# 1. CRITICAL SECRETS & ENVIRONMENT VARIABLES (NEVER COMMIT)
.env
.env.*
*.env
**/.env
**/.env.*
server/.env
client/.env
client/.env.local
client/.env.production
# Explicitly allow safe templates with placeholders only
!.env.example
!**/.env.example

# 2. PRIVATE KEYS, CERTIFICATES & TOKENS
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
id_rsa*
*.id_rsa
*.ppk

# 3. CLOUD CREDENTIALS & SERVICE ACCOUNTS
.aws/
secrets/
private/
credentials.json
client_secret*.json
service-account*.json
firebase-adminsdk*.json

# 4. LOCAL DATABASE RUNTIMES, CLUSTERS & DUMPS
data/
**/data/
server/data/
*.pid
*.dump
*.backup
*.bak
*.sqlite
*.sqlite3
*.db-journal
postmaster.pid

# 5. DEPENDENCIES
node_modules/
**/node_modules/
client/node_modules/
server/node_modules/

# 6. PRODUCTION BUILDS & COMPILATION ARTIFACTS
dist/
**/dist/
client/dist/
server/dist/
build/
.output/
*.zip

# 7. LOGS & DIAGNOSTICS
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pg.log

# 8. TEST COVERAGE & PROFILING
coverage/
.nyc_output/

# 9. OS & IDE TEMPORARY FILES
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
scratch/
tmp/
temp/

# ==============================================================================
# AutoMask Frontend — Environment Configuration Template
# ==============================================================================
# ⚠️ SECURITY NOTICE:
# Any variable prefixed with VITE_ will be bundled into static client-side JavaScript!
# NEVER put server secrets, database passwords, JWT secrets, Redis credentials,
# Meta App Secrets, or OpenAI keys into this file.
# ==============================================================================

# Target Backend API URL
# - In local development with Vite dev server proxying: '/api/v1' or 'http://localhost:5000/api/v1'
# - In production standalone static deployment: Full origin, e.g., 'https://api.automask.io/api/v1'
VITE_API_BASE_URL=http://localhost:5000/api/v1
